<Window x:Class="ExtendScreenServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExtendScreen" Height="480" Width="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Style="{StaticResource ModernWindow}">

    <Grid>
        <!-- Mode selection page -->
        <StackPanel x:Name="ModeSelectView" Margin="16" Visibility="Visible">
            <TextBlock Text="ExtendScreen" FontSize="18" FontWeight="Bold"
                       Foreground="#1A1A1A" Margin="0,0,0,10"/>

            <TextBlock Text="Select connection method" FontSize="14" Foreground="#666"
                       HorizontalAlignment="Center" Margin="0,20,0,20"/>

            <Button Content="Wi-Fi Connection" Height="48" FontSize="16" FontWeight="Medium"
                    Background="#1565C0" Foreground="White" BorderThickness="0"
                    Click="WifiMode_Click" Margin="0,0,0,16"
                    Cursor="Hand"/>

            <TextBlock Text="Phone and PC must be on the same LAN; the phone will automatically discover the PC"
                       FontSize="11" Foreground="#999" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <Button Content="ADB Connection" Height="48" FontSize="16" FontWeight="Medium"
                    Background="#2E7D32" Foreground="White" BorderThickness="0"
                    Click="UsbMode_Click" Margin="0,0,0,16"
                    Cursor="Hand"/>

            <TextBlock Text="Connect via ADB port forwarding, supports USB cable or wireless debugging"
                       FontSize="11" Foreground="#999" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <Button Content="Connect to another PC" Height="48" FontSize="16" FontWeight="Medium"
                    Background="#6A1B9A" Foreground="White" BorderThickness="0"
                    Click="ClientMode_Click" Margin="0,0,0,16"
                    Cursor="Hand"/>

            <TextBlock Text="Use this PC as an extended screen and connect to another PC running ExtendScreen"
                       FontSize="11" Foreground="#999" TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="ExtendScreen v1.0 — Plug-and-play screen extension tool"
                       FontSize="10" Foreground="#BBB" HorizontalAlignment="Center"
                       Margin="0,40,0,0"/>
        </StackPanel>

        <!-- Work page (Wi-Fi / USB server mode) -->
        <ScrollViewer x:Name="WorkView" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel Margin="16">
                <!-- Title + Back -->
                <DockPanel Margin="0,0,0,10">
                    <Button Content="← Back" FontSize="12" Background="Transparent"
                            BorderThickness="0" Foreground="#1565C0" Cursor="Hand"
                            Click="BackToModeSelect_Click" DockPanel.Dock="Left"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="ExtendScreen" FontSize="18" FontWeight="Bold"
                               Foreground="#1A1A1A" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Current mode -->
                <Border Background="#E3F2FD" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding ModeLabelText}" FontSize="12" Foreground="#1565C0"/>
                        <TextBlock Text="{Binding ModeDescription}" FontSize="11" Foreground="#666"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Local IP (only shown in Wi-Fi mode) -->
                <Border Background="#FFF3E0" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                        Visibility="{Binding IsWifiMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Local IP (enter this IP on the phone)" FontSize="12" Foreground="#E65100"/>
                        <TextBlock Text="{Binding LocalIpAddress}" FontSize="18" FontWeight="Bold"
                                   Foreground="#BF360C" FontFamily="Consolas" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Connection status -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Connection Status" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#CCC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#4CAF50"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="13" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding DisplayModeText}" FontSize="11" Foreground="#FF9800"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Device information -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Device Information" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Device Name:" FontSize="12" Foreground="#999"/>
                            <TextBlock Text="{Binding ConnectedDevice.DeviceName, TargetNullValue=---}"
                                       FontSize="12" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Connection Type:" FontSize="12" Foreground="#999"/>
                            <TextBlock Text="{Binding ConnectionType}" FontSize="12" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Resolution + Frame Rate horizontal row -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Resolution" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                      SelectedIndex="{Binding SelectedResolutionIndex}"
                                      Height="28" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Frame Rate" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding FpsOptions}"
                                      SelectedIndex="{Binding SelectedFpsIndex}"
                                      Height="28" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Disconnect button -->
                <Button Content="Disconnect this device"
                        Height="32" FontSize="13"
                        Background="#E53935" Foreground="White"
                        BorderThickness="0"
                        IsEnabled="{Binding IsConnected}"
                        Click="DisconnectButton_Click"
                        Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Client page (connect to another PC) -->
        <ScrollViewer x:Name="ClientView" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel Margin="16">
                <!-- Title + Back -->
                <DockPanel Margin="0,0,0,10">
                    <Button Content="← Back" FontSize="12" Background="Transparent"
                            BorderThickness="0" Foreground="#6A1B9A" Cursor="Hand"
                            Click="BackToModeSelect_Click" DockPanel.Dock="Left"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="Connect to another PC" FontSize="18" FontWeight="Bold"
                               Foreground="#1A1A1A" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Description -->
                <Border Background="#F3E5F5" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <TextBlock Text="Use this PC as an extended screen for another PC. Please run ExtendScreen on the other PC and select Wi-Fi or ADB mode."
                               FontSize="12" Foreground="#4A148C" TextWrapping="Wrap"/>
                </Border>

                <!-- Server IP -->
                <TextBlock Text="Server IP Address" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                <TextBox x:Name="ServerIpBox" Text="192.168." FontSize="16" Height="36"
                         Background="White" Foreground="#1A1A1A" BorderBrush="#DDD"
                         Padding="8,0,0,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <!-- Video Port -->
                <TextBlock Text="Video Port" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                <TextBox x:Name="ClientVideoPortBox" Text="12348" FontSize="16" Height="36"
                         Background="White" Foreground="#1A1A1A" BorderBrush="#DDD"
                         Padding="8,0,0,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <!-- Input Port -->
                <TextBlock Text="Input Port" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                <TextBox x:Name="ClientInputPortBox" Text="12347" FontSize="16" Height="36"
                         Background="White" Foreground="#1A1A1A" BorderBrush="#DDD"
                         Padding="8,0,0,0" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                <!-- Connect button -->
                <Button x:Name="ClientConnectBtn" Content="Connect" Height="42" FontSize="16" FontWeight="Bold"
                        Background="#6A1B9A" Foreground="White" BorderThickness="0"
                        Click="ClientConnect_Click" Cursor="Hand" Margin="0,0,0,12"/>

                <!-- Client status -->
                <Border x:Name="ClientStatusBorder" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Connection Status" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Ellipse x:Name="ClientStatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="#CCC"/>
                            <TextBlock x:Name="ClientStatusText" Text="Disconnected" FontSize="13"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Disconnect button -->
                <Button x:Name="ClientDisconnectBtn" Content="Disconnect"
                        Height="32" FontSize="13"
                        Background="#E53935" Foreground="White" BorderThickness="0"
                        Click="ClientDisconnect_Click" Cursor="Hand"
                        Visibility="Collapsed" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Client video display window (independent Window, opened via code) -->
    </Grid>
</Window>